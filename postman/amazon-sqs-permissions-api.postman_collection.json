                        "key": "Content-Type",
                        "value": "application/x-www-form-urlencoded"
                      },
                      {
                        "key": "Accept",
                        "value": "application/xml"
                      }
                    ],
                    "body": {
                      "mode": "urlencoded",
                      "urlencoded": [
                        {
                          "description": "(Required) ",
                          "key": "Action",
                          "value": "AddPermission"
                        },
                        {
                          "description": "(Required) The unique identification of the permission you are setting.",
                          "key": "Label",
                          "value": "<string>"
                        },
                        {
                          "description": "(Required) The account number of the principal to grant permission to",
                          "key": "AWSAccountId.1",
                          "value": "<string>"
                        },
                        {
                          "description": "(Required) The action the client wants to allow for the specified principal",
                          "key": "ActionName.1",
                          "value": "GetQueueUrl"
                        }
                      ]
                    },
                    "url": {
                      "raw": "{{baseUrl}}/:accountId/:queueName/permissions",
