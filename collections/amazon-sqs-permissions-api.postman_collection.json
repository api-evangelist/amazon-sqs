            "name": "Amazon Sqs Add a Permission to a Queue",
            "description": {
              "content": "Adds a permission to a queue for a specific principal. This allows sharing access to the queue. When you create a queue, you have full control access rights for the queue.",
              "type": "text/plain"
            },
